# Novel Sanctuary — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon/public key (safe for client-side use — scoped by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Supabase project ref (used by Lovable tooling)
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# NOTE: Edge Function secrets (VOID_AI_API_KEY, LOVABLE_API_KEY, etc.)
# must be set in the Supabase dashboard under Project → Edge Functions → Secrets.
# Do NOT put them here — they are server-side only.
