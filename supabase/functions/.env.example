# Novel Sanctuary — Edge Function Environment Variables
# =============================================================================
# Copy to `.env` in this directory for local `supabase functions serve` runs,
# or set these as secrets on your Supabase project:
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# DO NOT commit `.env` with real values — only this `.env.example` is tracked.
#
# In production these are deployed via the shared Kestra flow
# (infrastructure.supabase/supabase-functions-sync), which injects Infisical
# secrets prefixed with NOVEL_SANCTUARY_ — hence the prefix below. Keep the
# prefix in your local `.env` too so it matches what the code actually reads.
# =============================================================================

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# VoidAI API key — used by novel-metadata-v2's merge/synthesis step (plain
# chat model, no search)
NOVEL_SANCTUARY_VOID_AI_API_KEY=

# Model used by novel-metadata-v2's merge step (defaults to gpt-4o-mini if unset)
NOVEL_MERGE_MODEL=gpt-4o-mini

# LiteRouter API key — used by novel-chapter-search's last-resort AI-search
# fallback (only fires when a title has no Royal Road page to scrape
# structurally). Replaced VoidAI's sonar-pro, which was persistently
# 500ing account-wide as of 2026-07-27. NOTE: LiteRouter enforces a ~7s
# per-key cooldown between messages — the function already sleeps 8s
# between its two sequential calls to respect this, do not remove that
# without confirming the cooldown live first.
NOVEL_SANCTUARY_LITEROUTER_API_KEY=

# Model used by novel-chapter-search's fallback (defaults to
# gpt-4o-mini-search-preview if unset)
NOVEL_CHAPTER_FALLBACK_MODEL=gpt-4o-mini-search-preview

# LiteLLM gateway key — used by generate-cover-prompt for LLM completions
NOVEL_SANCTUARY_LITELLM_API_KEY=

# Model used by generate-cover-prompt (defaults to void/gemini-3.5-flash if
# unset). NOTE: void/gemini-3.1-flash-lite-preview is listed on LiteLLM's
# /v1/models but its backend deployment 404s on actual completions — do not
# revert to it without re-verifying live first.
COVER_PROMPT_MODEL=void/gemini-3.5-flash

# ── Image Generation ─────────────────────────────────────────────────────────

# fal.ai API key — used by novel-cover-generate for cover art (model pinned
# to OpenAI's gpt-image-2, `openai/gpt-image-2` on fal's async queue).
# VoidAI's own gpt-image endpoint is down (as of 2026-07-27) and KIE's
# unified media API does not carry gpt-image models at all — fal.ai is the
# only remaining provider serving gpt-image-2 directly. Abacus (nano_banana2)
# was a prior stopgap, replaced now that gpt-image-2 is required regardless
# of provider availability.
NOVEL_SANCTUARY_FAL_API_KEY=

# ── Search / Scraping ────────────────────────────────────────────────────────

# SearXNG proxy URL — used by novel-metadata-v2 for multi-engine web search
# (Royal Road / NovelUpdates / WebNovel / ScribbleHub discovery + fallback).
# Point this at your self-hosted SearXNG instance or a Supabase Edge Function
# proxy that wraps it, e.g. https://your-supabase-ref.supabase.co/functions/v1/searx-proxy
NOVEL_SANCTUARY_SEARX_PROXY_URL=

# SearXNG proxy anon key (JWT) — Supabase anon key for the project hosting the
# searx-proxy function, or a shared secret if using a standalone proxy.
NOVEL_SANCTUARY_SEARX_PROXY_KEY=

# Byparr (FlareSolverr-compatible Turnstile/Cloudflare-challenge solver) endpoint
# — used by novel-metadata-v2 to fetch NovelUpdates/WebNovel pages directly.
# Defaults to the deployed sidecar on `webservices` if unset.
NOVEL_SANCTUARY_BYPARR_URL=http://129.146.108.173:8191/v1

# ── Observability (optional) ─────────────────────────────────────────────────

# LangFuse tracing — all functions send traces when these are set.
# If not set, tracing is silently skipped.
NOVEL_SANCTUARY_LANGFUSE_PUBLIC_KEY=
NOVEL_SANCTUARY_LANGFUSE_SECRET_KEY=
# Override to use a self-hosted LangFuse instance (defaults to cloud.langfuse.com)
NOVEL_SANCTUARY_LANGFUSE_HOST=https://your-langfuse-instance.com
