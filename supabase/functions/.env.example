# Manga Sanctuary — Edge Function Environment Variables
# =============================================================================
# Copy to `.env` in this directory for local `supabase functions serve` runs,
# or set these as secrets on your Supabase project:
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# DO NOT commit `.env` with real values — only this `.env.example` is tracked.
#
# In production these are deployed via the shared Kestra flow
# (infrastructure.supabase/supabase-functions-sync), which injects Infisical
# secrets prefixed with MANGA_SANCTUARY_ — hence the prefix below. Keep the
# prefix in your local `.env` too so it matches what the code actually reads.
#
# These functions were ported from novel-sanctuary's edge functions, adapted
# for image content — structured metadata/chapter-list sources are AniList,
# MangaDex, and MangaUpdates (all official JSON APIs, no scraping needed for
# the primary path), and chapter "content" is an ordered page-image array
# instead of prose text.
# =============================================================================

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# LiteRouter API key — used by (1) manga-metadata-v2's merge/synthesis step
# (plain chat model, no search), (2) manga-chapter-search's last-resort
# AI-search fallback (only fires when a title has no MangaDex entry at all),
# and (3) generate-cover-prompt's structured cover-prompt synthesis. NOT yet
# live-verified on this app as of the port — confirm this secret is
# provisioned in Infisical under the MANGA_SANCTUARY_ prefix before relying
# on any of these three in production. NOTE: LiteRouter enforces a ~7-8s
# per-key cooldown between messages — manga-chapter-search already sleeps 8s
# between its sequential calls to respect this.
MANGA_SANCTUARY_LITEROUTER_API_KEY=

# Direct OpenAI API key — fallback provider for manga-metadata-v2's merge
# step, used only if LiteRouter is unset or its retries are exhausted.
MANGA_SANCTUARY_OPENAI_API_KEY=

# Model used by manga-metadata-v2's merge step via LiteRouter (defaults to
# grok-4.1-fast-non-reasoning if unset — least euphemistic on explicit
# content of the models tested, relevant since this catalog skews
# Ecchi/Adult/Mature)
MANGA_SANCTUARY_MERGE_MODEL=grok-4.1-fast-non-reasoning

# Model used by manga-metadata-v2's OpenAI fallback (defaults to
# gpt-4o-mini if unset)
MANGA_SANCTUARY_MERGE_FALLBACK_MODEL=gpt-4o-mini

# Model used by manga-chapter-search's AI fallback (defaults to
# gpt-4o-mini-search-preview if unset — needs the -search-preview suffix for
# real web-search grounding)
MANGA_CHAPTER_FALLBACK_MODEL=gpt-4o-mini-search-preview

# Model used by generate-cover-prompt via LiteRouter (defaults to
# grok-4.1-fast-non-reasoning if unset — same reasoning as
# MANGA_SANCTUARY_MERGE_MODEL above)
COVER_PROMPT_MODEL=grok-4.1-fast-non-reasoning

# ── Image Generation ─────────────────────────────────────────────────────────

# fal.ai API key — used by novel-cover-generate for cover art (model pinned
# to OpenAI's gpt-image-2, `openai/gpt-image-2` on fal's async queue). Same
# provider/model choice as novel-sanctuary — see that repo's history for why
# (gpt-image-2 required regardless of provider, fal.ai is the only remaining
# provider serving it directly).
MANGA_SANCTUARY_FAL_API_KEY=

# ── Search / Scraping ────────────────────────────────────────────────────────

# SearXNG proxy URL — used by manga-metadata-v2 (last-resort text-snippet
# fallback, only fires when AniList/MangaDex/MangaUpdates all miss) and
# novel-cover-search (image search for manual cover picking). Point this at
# your self-hosted SearXNG instance or a Supabase Edge Function proxy that
# wraps it.
MANGA_SANCTUARY_SEARX_PROXY_URL=

# SearXNG proxy anon key (JWT) — Supabase anon key for the project hosting
# the searx-proxy function, or a shared secret if using a standalone proxy.
MANGA_SANCTUARY_SEARX_PROXY_KEY=

# Byparr (FlareSolverr-compatible Turnstile/Cloudflare-challenge solver)
# endpoint — used ONLY by novel-chapter-content's generic (non-MangaDex)
# fallback page-image scraper, for aggregator sites behind Cloudflare.
# MangaDex's own API (the primary path for both chapter-search and
# chapter-content) needs no Byparr at all. Defaults to the deployed sidecar
# on `webservices` if unset.
MANGA_SANCTUARY_BYPARR_URL=http://129.146.108.173:8191/v1

# ── Storage (page image re-hosting) ─────────────────────────────────────────

# Public URL of this Supabase instance — used to build public-facing URLs for
# re-hosted chapter page images (the platform-injected SUPABASE_URL inside
# edge functions is the internal Docker network address, not reachable from
# a browser). SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY themselves are
# auto-injected by the platform, no secret needed for those.
MANGA_SANCTUARY_SUPABASE_PUBLIC_URL=https://supabase.neurolearninglabs.com

# ── Observability (optional) ─────────────────────────────────────────────────

# LangFuse tracing — all functions send traces when these are set.
# If not set, tracing is silently skipped.
MANGA_SANCTUARY_LANGFUSE_PUBLIC_KEY=
MANGA_SANCTUARY_LANGFUSE_SECRET_KEY=
# Override to use a self-hosted LangFuse instance (defaults to cloud.langfuse.com)
MANGA_SANCTUARY_LANGFUSE_HOST=https://your-langfuse-instance.com
