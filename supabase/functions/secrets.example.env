# Manga Sanctuary — Edge Function Secrets
# =============================================================================
# Deployed via the shared Kestra flow (infrastructure.supabase/supabase-functions-sync),
# which injects Infisical secrets prefixed with MANGA_SANCTUARY_ (see .kestra.yml
# env_prefix) directly into each function's runtime environment, alongside the
# auto-injected SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
#
# Set the real values in Infisical under the MANGA_SANCTUARY_ prefix — not in
# Supabase Studio directly, and never commit this file with real values.
#
# Ported from novel-sanctuary's edge functions, adapted for image content —
# see supabase/functions/.env.example in this repo for the full per-function
# breakdown of what each secret is used for.
# =============================================================================

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# LiteRouter API key — used by manga-metadata-v2's merge step, manga-chapter-search's
# AI-search fallback, and generate-cover-prompt. NOT yet live-verified on this
# app as of the port — confirm this is actually provisioned before relying on it.
MANGA_SANCTUARY_LITEROUTER_API_KEY=

# Direct OpenAI API key — fallback provider for manga-metadata-v2's merge step.
MANGA_SANCTUARY_OPENAI_API_KEY=

# fal.ai API key — used by novel-cover-generate for cover art. Model is
# pinned to OpenAI's gpt-image-2 (`openai/gpt-image-2` on fal's async queue).
MANGA_SANCTUARY_FAL_API_KEY=

# ── Search ───────────────────────────────────────────────────────────────────

# SearXNG proxy URL — used by manga-metadata-v2's last-resort text-snippet
# fallback and novel-cover-search's image search. For self-hosted Supabase,
# point this at your own SearXNG instance or a Supabase Edge Function proxy.
MANGA_SANCTUARY_SEARX_PROXY_URL=

# SearXNG proxy anon key (JWT) — the Supabase anon key for the project
# hosting the searx-proxy function, or a shared secret if using a standalone proxy.
MANGA_SANCTUARY_SEARX_PROXY_KEY=

# Byparr (Cloudflare Turnstile solver sidecar) URL — used ONLY by
# novel-chapter-content's generic (non-MangaDex) fallback page-image scraper.
# Optional; defaults to the webservices deployment if unset.
MANGA_SANCTUARY_BYPARR_URL=http://129.146.108.173:8191/v1

# ── Storage (page image re-hosting) ─────────────────────────────────────────

# Public URL of this Supabase instance — used to build public-facing URLs for
# re-hosted chapter page images.
MANGA_SANCTUARY_SUPABASE_PUBLIC_URL=https://supabase.neurolearninglabs.com

# ── Observability (optional) ─────────────────────────────────────────────────

# LangFuse tracing — all functions send traces when these are set.
# If not set, tracing is silently skipped.
MANGA_SANCTUARY_LANGFUSE_PUBLIC_KEY=
MANGA_SANCTUARY_LANGFUSE_SECRET_KEY=
# Override to use a self-hosted LangFuse instance (defaults to cloud.langfuse.com)
MANGA_SANCTUARY_LANGFUSE_HOST=https://your-langfuse-instance.com
