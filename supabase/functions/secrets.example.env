# Novel Sanctuary — Edge Function Secrets
# =============================================================================
# Deployed via the shared Kestra flow (infrastructure.supabase/supabase-functions-sync),
# which injects Infisical secrets prefixed with NOVEL_SANCTUARY_ (see .kestra.yml
# env_prefix) directly into each function's runtime environment, alongside the
# auto-injected SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
#
# Set the real values in Infisical under the NOVEL_SANCTUARY_ prefix — not in
# Supabase Studio directly, and never commit this file with real values.
# =============================================================================

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# VoidAI API key — used by novel-metadata-v2 (merge step, plain non-search model)
NOVEL_SANCTUARY_VOID_AI_API_KEY=

# LiteRouter API key — used by novel-chapter-search's AI-search fallback
# (gpt-4o-mini-search-preview). Replaced VoidAI's sonar-pro, which was
# persistently 500ing account-wide as of 2026-07-27.
NOVEL_SANCTUARY_LITEROUTER_API_KEY=

# fal.ai API key — used by novel-cover-generate for cover art. Model is
# pinned to OpenAI's gpt-image-2 (`openai/gpt-image-2` on fal's async
# queue) regardless of provider — VoidAI's own gpt-image is down (as of
# 2026-07-27) and KIE's unified media API doesn't carry gpt-image at all.
NOVEL_SANCTUARY_FAL_API_KEY=

# LiteLLM gateway key — used by generate-cover-prompt for LLM completions
NOVEL_SANCTUARY_LITELLM_API_KEY=

# ── Search ───────────────────────────────────────────────────────────────────

# SearXNG proxy URL — used by novel-metadata-v2 and novel-chapter-search for
# multi-engine web search discovery. For self-hosted Supabase, point this at
# your own SearXNG instance or a Supabase Edge Function proxy that wraps it.
NOVEL_SANCTUARY_SEARX_PROXY_URL=

# SearXNG proxy anon key (JWT) — the Supabase anon key for the project
# hosting the searx-proxy function, or a shared secret if using a standalone proxy.
NOVEL_SANCTUARY_SEARX_PROXY_KEY=

# Byparr (Cloudflare Turnstile solver sidecar) URL — used by novel-metadata-v2
# and novel-chapter-search to fetch NovelUpdates/WebNovel pages, and by
# novel-chapter-content for non-Royal-Road chapter text scraping. Optional;
# defaults to the webservices deployment if unset.
NOVEL_SANCTUARY_BYPARR_URL=http://129.146.108.173:8191/v1

# ── Observability (optional) ─────────────────────────────────────────────────

# LangFuse tracing — all functions send traces when these are set.
# If not set, tracing is silently skipped.
NOVEL_SANCTUARY_LANGFUSE_PUBLIC_KEY=
NOVEL_SANCTUARY_LANGFUSE_SECRET_KEY=
# Override to use a self-hosted LangFuse instance (defaults to cloud.langfuse.com)
NOVEL_SANCTUARY_LANGFUSE_HOST=https://your-langfuse-instance.com
